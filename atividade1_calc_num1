        "import math\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "def hagen(r, l, u, p):\n",
        "  pi = math.pi\n",
        "  return (pi * (r**4) * p) / (8 * l * u)\n",
        "\n",
        "\n",
        "def truncar(numero, casas):\n",
        "  fator = 10**casas\n",
        "  return math.trunc(numero * fator) / fator\n",
        "\n",
        "\n",
        "def erro_absoluto(ref, aprox):\n",
        "  return abs(ref - aprox)\n",
        "\n",
        "\n",
        "def erro_relativo(ref, aprox):\n",
        "  return erro_absoluto(ref, aprox) / abs(ref)\n",
        "\n",
        "\n",
        "\n",
        "r_mm = 0.8\n",
        "r = r_mm * 1e-3\n",
        "L = 0.2\n",
        "u = 3.5e-3\n",
        "p = 1200.0\n",
        "\n",
        "\n",
        "Q_referencia = hagen(r, L, u, p)\n",
        "print(\"Q de referencia\", Q_referencia)\n",
        "print(\"-----------------------\")\n",
        "\n",
        "r_trunc = truncar(r_mm, 1) * 1e-3\n",
        "r_aprox = round(r_mm, 1) * 1e-3\n",
        "Q_rtrunc = hagen(r_trunc, L, u, p)\n",
        "Q_raprox = hagen(r_aprox, L, u, p)\n",
