        "\n",
        "def minimo(valores):\n",
        "    return min(valores)\n",
        "\n",
        "def maximo(valores):\n",
        "    return max(valores)\n",
        "\n",
        "def amplitude(max, min):\n",
        "    return max-min\n",
        "\n",
        "def desvio_padrao(valores):\n",
        "    return statistics.stdev(valores)\n",
        "\n",
        "def media(valores):\n",
        "  resultado=0\n",
