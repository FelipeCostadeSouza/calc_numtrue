        "def erro_absoluto(ref, aprox):\n",
        "  return abs(ref - aprox)\n",
        "\n",
        "def erro_relativo(ref, aprox):\n",
        "  return erro_absoluto(ref, aprox)/abs(ref)\n",
        "\n",
        "def truncar(numero, casas):\n",
